rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email in [
               'francoismeiring0203@gmail.com',
               'lombardsunika@gmail.com'
             ];
    }

    function isAdminImageWrite() {
      return isAdmin()
             && request.resource.size < 15 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    match /artworks/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminImageWrite();
      allow delete: if isAdmin();
    }

    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminImageWrite();
      allow delete: if isAdmin();
    }

    match /accomplishments/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminImageWrite();
      allow delete: if isAdmin();
    }

    match /profile/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminImageWrite();
      allow delete: if isAdmin();
    }

    match /portfolioBranding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdminImageWrite();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
