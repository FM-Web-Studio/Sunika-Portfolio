rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Keep in sync with ADMIN_EMAILS in both frontends and with storage.rules.
    function isAdmin() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email.lower() in [
               'francoismeiring0203@gmail.com',
               'lombardsunika@gmail.com'
             ];
    }

    // A contact form message, exactly as both frontends write it.
    // expireAt feeds the TTL policy that deletes it; the window allows for a visitor's clock being off.
    function isContactMessage() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'email', 'message', 'createdAt', 'expireAt'])
             && d.keys().hasAll(['name', 'email', 'message', 'createdAt', 'expireAt'])
             && d.name is string && d.name.size() > 0 && d.name.size() <= 200
             && d.email is string && d.email.size() <= 320 && d.email.matches('^[^ @]+@[^ @]+[.][^ @]+$')
             && d.message is string && d.message.size() > 0 && d.message.size() <= 5000
             && d.createdAt == request.time
             && d.expireAt is timestamp
             && d.expireAt > request.time + duration.value(300, 'd')
             && d.expireAt < request.time + duration.value(400, 'd');
    }

    function isVisitor() {
      return request.auth != null;
    }

    function ownVote(uid) {
      return isVisitor() && request.auth.uid == uid;
    }

    function oldCount(res, field) {
      return res.data.get(field, 0);
    }

    // A vote document may only be added or removed together with the matching counter on its artwork.
    function countMovesBy(artworkId, field, step) {
      return getAfter(/databases/$(database)/documents/artworks/$(artworkId)).data.get(field, 0)
             == get(/databases/$(database)/documents/artworks/$(artworkId)).data.get(field, 0) + step;
    }

    match /artworks/{artworkId} {
      allow read: if true;

      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['ratingSum', 'ratingCount'])
          && isVisitor()
          && request.resource.data.ratingCount is int
          && request.resource.data.ratingSum is int
          && request.resource.data.ratingCount == oldCount(resource, 'ratingCount') + 1
          && request.resource.data.ratingSum >= oldCount(resource, 'ratingSum') + 1
          && request.resource.data.ratingSum <= oldCount(resource, 'ratingSum') + 5
          && !exists(/databases/$(database)/documents/artworks/$(artworkId)/raters/$(request.auth.uid))
          && getAfter(/databases/$(database)/documents/artworks/$(artworkId)/raters/$(request.auth.uid)).data.value
             == request.resource.data.ratingSum - oldCount(resource, 'ratingSum')
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
          && isVisitor()
          && request.resource.data.likeCount is int
          && request.resource.data.likeCount >= 0
          && (
            (request.resource.data.likeCount == oldCount(resource, 'likeCount') + 1
             && !exists(/databases/$(database)/documents/artworks/$(artworkId)/likers/$(request.auth.uid))
             && existsAfter(/databases/$(database)/documents/artworks/$(artworkId)/likers/$(request.auth.uid)))
            ||
            (request.resource.data.likeCount == oldCount(resource, 'likeCount') - 1
             && exists(/databases/$(database)/documents/artworks/$(artworkId)/likers/$(request.auth.uid))
             && !existsAfter(/databases/$(database)/documents/artworks/$(artworkId)/likers/$(request.auth.uid)))
          )
        );

      match /raters/{uid} {
        allow read:   if ownVote(uid) || isAdmin();
        allow create: if ownVote(uid)
                      && request.resource.data.keys().hasOnly(['value', 'createdAt'])
                      && request.resource.data.value is int
                      && request.resource.data.value >= 1
                      && request.resource.data.value <= 5
                      && request.resource.data.createdAt == request.time
                      && countMovesBy(artworkId, 'ratingCount', 1);
        allow update: if false;
        allow delete: if isAdmin();
      }

      match /likers/{uid} {
        allow read:   if ownVote(uid) || isAdmin();
        allow create: if ownVote(uid)
                      && request.resource.data.keys().hasOnly(['createdAt'])
                      && request.resource.data.createdAt == request.time
                      && countMovesBy(artworkId, 'likeCount', 1);
        allow update: if false;
        allow delete: if isAdmin() || (ownVote(uid) && countMovesBy(artworkId, 'likeCount', -1));
      }
    }

    match /accomplishments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /education/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /experience/{id} { allow read: if true; allow write: if isAdmin(); }
    match /profile/{doc}   { allow read: if true; allow write: if isAdmin(); }

    match /portfolioMessages/{doc} {
      allow create: if isContactMessage();
      allow read, update, delete: if isAdmin();
    }

    match /galleryMessages/{doc} {
      allow create: if isContactMessage();
      allow read, update, delete: if isAdmin();
    }

    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
